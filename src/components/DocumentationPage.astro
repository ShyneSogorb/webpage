---
let { text, url } = Astro.props;

if(!text) text = "Documentation"
if(!url) url = Astro.url


---

<div>
    <a href={ url + "/documentation" }>{text}</a>
</div>

<style>

    * a{
        color: black;
    }

    @media (prefers-color-scheme: dark) {
    * a {
        color: #dcb;
    }

</style>