---
import { Nav, Navbar, type NavItemType } from 'astro-bootstrap';
import type { NavbarItemType } from 'astro-bootstrap';

import ProjectsDropdown from './ProjectsDropdown.astro';

---

<style>
    :global(.nav-item > *) {
        color: var(--foreground);
    }
    :global(.nav-item > *:hover) {
        border-radius: 10px;
        border: 1px solid var(--foreground);
        background-color: var(--primary);
        color: var(--background);
    }
</style>

<Nav class="d-flex justify-content-evenly align-items-center p-1">
    <li class="nav-item">
        <a href="/webpage" class="nav-link">Home</a>
    </li>
    <li class="nav-item">
        <ProjectsDropdown />
    </li>
    <li class="nav-item">
        <a href="https://protectoravillena.com/" class="nav-link">Shelter</a>
    </li>
</Nav>
