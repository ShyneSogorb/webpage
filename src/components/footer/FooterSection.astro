---
const { Title, Reference } = Astro.props;
---

<div class="col mb-3 text-center">
  <h5 class="footer-title">{Title}</h5>
  <ul class="nav flex-column">
    {
      Reference.map((v, i) => (
        <li key={i} class="nav-item mb-2">
          <a class="nav-link p-0 text-center text-white" href={v.href} target="_blank">
            {v.name}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .footer-title {
    font-size: 1.2rem;
    font-weight: bold;
    margin-bottom: 1rem;
  }
  .nav-link {
    color: var(--foreground);
  }
  .nav-link:hover {
    color: var(--primary);
  }
</style>