        <name>DIRTY_SETTER</name>
        <param><defname>Type</defname></param>
        <param><defname>VarName</defname></param>
        <initializer>	void Set##VarName(Type New##VarName) {  \
		if(New##VarName!=VarName) {         \
		VarName = New##VarName;             \
		MarkDirty();                        \
		}                                   \
	}</initializer>
